          "body": "<style>\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\nbody{font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;background:#f7f4ee;color:#1a2a3a;line-height:1.7;-webkit-font-smoothing:antialiased}\nhtml{}\na{color:inherit;text-decoration:none}\nimg{display:block;max-width:100%}\n\n.wrap{max-width:1200px;margin:0 auto;padding:0 24px}\n\n/* Brand mark shared */\n.brand-mark{display:inline-flex;align-items:center;gap:10px;font-weight:700}\n.brand-mark .dot{width:12px;height:12px;border-radius:3px;background:#d4a04a}\n.brand-mark .name{letter-spacing:0.04em}\n\n/* === NAV (anchor tabs inline in hero) === */\n.hero{position:relative;background:linear-gradient(180deg,#0d1f33 0%,#16314d 60%,#1b3a5c 100%);color:#f7f4ee;overflow:hidden}\n.hero::before{content:\"\";position:absolute;top:-120px;right:-120px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(212,160,74,0.18),transparent 70%);pointer-events:none}\n.hero::after{content:\"\";position:absolute;bottom:-160px;left:-100px;width:380px;height:380px;border-radius:50%;background:radial-gradient(circle,rgba(212,160,74,0.08),transparent 70%);pointer-events:none}\n\n.topbar{position:relative;z-index:5;display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid rgba(247,244,238,0.08)}\n.topbar .brand-mark .name{font-size:18px}\n.topbar .brand-mark .name span{color:#d4a04a}\n\n.anchor-tabs{display:flex;gap:8px;flex-wrap:wrap}\n.anchor-tabs a{font-size:13px;padding:8px 14px;border-radius:999px;border:1px solid rgba(247,244,238,0.18);color:#cdd6e0;letter-spacing:0.04em;transition:all 0.2s}\n.anchor-tabs a:hover{border-color:#d4a04a;color:#d4a04a}\n\n.hero-grid{position:relative;z-index:5;display:grid;grid-template-columns:1.15fr 1fr;gap:48px;align-items:start;padding:80px 0 96px}\n\n.hero-text .eyebrow{display:inline-block;font-size:12px;letter-spacing:0.2em;color:#d4a04a;text-transform:uppercase;margin-bottom:24px;padding:6px 12px;border:1px solid rgba(212,160,74,0.4);border-radius:4px}\n.hero-text h1{font-size:48px;line-height:1.18;font-weight:700;letter-spacing:-0.01em;margin-bottom:20px}\n.hero-text h1 span{color:#d4a04a}\n.hero-text .lede{font-size:16px;color:#cdd6e0;max-width:520px;margin-bottom:32px}\n.hero-text .quick-stats{display:flex;gap:32px;flex-wrap:wrap;margin-bottom:36px;border-top:1px solid rgba(247,244,238,0.12);border-bottom:1px solid rgba(247,244,238,0.12);padding:20px 0}\n.hero-text .quick-stats div{display:flex;flex-direction:column}\n.hero-text .quick-stats .num{font-size:26px;font-weight:700;color:#d4a04a;font-family:\"SF Mono\",Menlo,Consolas,monospace}\n.hero-text .quick-stats .lbl{font-size:12px;color:#9aa7b6;letter-spacing:0.06em}\n.hero-text .cta-row{display:flex;gap:12px;flex-wrap:wrap}\n.btn{display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:600;padding:14px 22px;border-radius:10px;letter-spacing:0.04em;transition:transform 0.18s}\n.btn:hover{transform:translateY(-1px)}\n.btn-primary{background:#d4a04a;color:#0d1f33}\n.btn-ghost{border:1px solid rgba(247,244,238,0.3);color:#f7f4ee}\n.btn-ghost:hover{border-color:#d4a04a;color:#d4a04a}\n\n/* Hero right info panel */\n.hero-panel{background:rgba(247,244,238,0.04);border:1px solid rgba(212,160,74,0.28);border-radius:20px;padding:32px;backdrop-filter:blur(6px);box-shadow:0 30px 60px rgba(13,31,51,0.45)}\n.hero-panel h2{font-size:14px;letter-spacing:0.16em;color:#d4a04a;text-transform:uppercase;margin-bottom:20px;display:flex;align-items:center;gap:10px}\n.hero-panel h2::before{content:\"\";width:8px;height:8px;border-radius:2px;background:#d4a04a}\n.hero-panel .panel-row{display:flex;justify-content:space-between;align-items:flex-start;padding:14px 0;border-bottom:1px dashed rgba(247,244,238,0.12);font-size:14px}\n.hero-panel .panel-row:last-child{border-bottom:none}\n.hero-panel .panel-row .k{color:#9aa7b6;max-width:55%}\n.hero-panel .panel-row .v{color:#f7f4ee;font-weight:600;text-align:right;max-width:45%}\n.hero-panel .panel-row .v small{display:block;font-weight:400;color:#9aa7b6;font-size:12px;margin-top:2px}\n.panel-foot{margin-top:20px;padding-top:20px;border-top:1px solid rgba(247,244,238,0.12);display:flex;justify-content:space-between;align-items:center}\n.panel-foot .price{font-family:\"SF Mono\",Menlo,Consolas,monospace;font-size:22px;color:#d4a04a;font-weight:700}\n.panel-foot .price small{font-family:inherit;font-size:11px;color:#9aa7b6;display:block;font-weight:400;letter-spacing:0.04em}\n\n/* === SECTION COMMON === */\nsection{padding:88px 0;scroll-margin-top:16px}\n.section-head{margin-bottom:48px;max-width:680px}\n.section-head .tag{font-size:12px;letter-spacing:0.2em;color:#d4a04a;text-transform:uppercase;margin-bottom:14px;display:inline-block}\n.section-head h2{font-size:34px;line-height:1.25;font-weight:700;color:#0d1f33;margin-bottom:14px;letter-spacing:-0.01em}\n.section-head p{font-size:15px;color:#4a5868;max-width:600px}\n\n/* === SCENARIOS === */\n.scenarios{background:#fff}\n.scenario-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}\n.scenario{background:#f7f4ee;border-radius:18px;padding:32px 26px;box-shadow:0 10px 28px rgba(13,31,51,0.06);transition:transform 0.25s,box-shadow 0.25s}\n.scenario:hover{transform:translateY(-4px);box-shadow:0 24px 44px rgba(13,31,51,0.1)}\n.scenario .ico{width:48px;height:48px;border-radius:12px;background:#0d1f33;color:#d4a04a;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:20px;margin-bottom:18px;font-family:\"SF Mono\",Menlo,Consolas,monospace}\n.scenario h3{font-size:18px;font-weight:700;color:#0d1f33;margin-bottom:10px}\n.scenario p{font-size:14px;color:#4a5868;margin-bottom:14px}\n.scenario ul{list-style:none;border-top:1px dashed rgba(13,31,51,0.12);padding-top:14px}\n.scenario ul li{font-size:13px;color:#4a5868;padding:5px 0 5px 18px;position:relative}\n.scenario ul li::before{content:\"→\";position:absolute;left:0;color:#d4a04a;font-weight:700}\n\n/* === WORKFLOW === */\n.workflow{background:#f7f4ee}\n.workflow-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:8px}\n.step{position:relative;background:#fff;border-radius:14px;padding:28px 22px;box-shadow:0 6px 18px rgba(13,31,51,0.05)}\n.step .num{position:absolute;top:-14px;left:22px;width:36px;height:36px;border-radius:10px;background:#0d1f33;color:#d4a04a;display:flex;align-items:center;justify-content:center;font-weight:700;font-family:\"SF Mono\",Menlo,Consolas,monospace;font-size:16px}\n.step h3{font-size:16px;font-weight:700;color:#0d1f33;margin:18px 0 8px}\n.step p{font-size:13px;color:#4a5868}\n.step .meta{display:inline-block;margin-top:14px;font-size:11px;letter-spacing:0.12em;color:#d4a04a;text-transform:uppercase}\n\n/* === PLANS (stair-step) === */\n.plans{background:#fff}\n.plans-stairs{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;align-items:start;margin-top:12px}\n.plan{background:#fff;border-radius:20px;padding:34px 30px;box-shadow:0 12px 30px rgba(13,31,51,0.07);transition:transform 0.3s,box-shadow 0.3s;position:relative}\n.plan:nth-child(1){border-top:4px solid #9aa7b6}\n.plan:nth-child(2){border-top:4px solid #d4a04a;transform:translateY(-16px);box-shadow:0 22px 48px rgba(13,31,51,0.12)}\n.plan:nth-child(3){border-top:4px solid #0d1f33;transform:translateY(-32px);box-shadow:0 30px 60px rgba(13,31,51,0.15)}\n.plan:hover{transform:translateY(calc(var(--y,0px) - 4px))}\n.plan:nth-child(2):hover{transform:translateY(-20px)}\n.plan:nth-child(3):hover{transform:translateY(-36px)}\n.plan .badge{position:absolute;top:-12px;right:24px;background:#d4a04a;color:#0d1f33;font-size:11px;font-weight:700;padding:5px 12px;border-radius:20px;letter-spacing:0.1em}\n.plan h3{font-size:14px;font-weight:700;color:#9aa7b6;letter-spacing:0.16em;text-transform:uppercase;margin-bottom:8px}\n.plan .plan-price{font-family:\"SF Mono\",Menlo,Consolas,monospace;font-size:34px;color:#0d1f33;font-weight:700;margin-bottom:4px}\n.plan .plan-price small{font-family:inherit;font-size:13px;color:#9aa7b6;font-weight:400;margin-left:4px}\n.plan .annual{font-size:12px;color:#4a5868;padding-bottom:18px;margin-bottom:18px;border-bottom:1px dashed rgba(13,31,51,0.12)}\n.plan ul{list-style:none;margin-bottom:24px}\n.plan ul li{font-size:14px;color:#1a2a3a;padding:9px 0 9px 26px;position:relative;border-bottom:1px solid rgba(13,31,51,0.06)}\n.plan ul li:last-child{border-bottom:none}\n.plan ul li::before{content:\"✓\";position:absolute;left:0;top:9px;color:#d4a04a;font-weight:700}\n.plan .plan-cta{display:block;text-align:center;padding:14px;border-radius:12px;background:#0d1f33;color:#f7f4ee;font-weight:600;font-size:14px;transition:background 0.2s}\n.plan .plan-cta:hover{background:#d4a04a;color:#0d1f33}\n.plan.featured .plan-cta{background:#d4a04a;color:#0d1f33}\n.plan.featured .plan-cta:hover{background:#b8893a;color:#0d1f33}\n\n/* === DASHBOARD MOCK === */\n.dashboard{background:#0d1f33;color:#f7f4ee;position:relative;overflow:hidden}\n.dashboard::before{content:\"\";position:absolute;top:10%;left:-100px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(212,160,74,0.12),transparent 70%);pointer-events:none}\n.dashboard .section-head h2{color:#f7f4ee}\n.dashboard .section-head p{color:#9aa7b6}\n.dashboard .section-head .tag{border:1px solid rgba(212,160,74,0.4);padding:6px 12px;border-radius:4px}\n.dash-grid{display:grid;grid-template-columns:2fr 1fr;gap:28px;align-items:start}\n.dash-card{background:rgba(247,244,238,0.05);border:1px solid rgba(212,160,74,0.22);border-radius:18px;padding:28px;backdrop-filter:blur(8px)}\n.dash-card h3{font-size:13px;letter-spacing:0.16em;color:#d4a04a;text-transform:uppercase;margin-bottom:20px}\n.bar-list{display:flex;flex-direction:column;gap:14px}\n.bar-list li{list-style:none}\n.bar-list .label{display:flex;justify-content:space-between;font-size:13px;color:#cdd6e0;margin-bottom:6px}\n.bar-list .label span:last-child{color:#d4a04a;font-family:\"SF Mono\",Menlo,Consolas,monospace}\n.bar{height:8px;background:rgba(247,244,238,0.08);border-radius:6px;overflow:hidden}\n.bar i{display:block;height:100%;background:linear-gradient(90deg,#d4a04a,#b8893a);border-radius:6px}\n.dash-side{display:flex;flex-direction:column;gap:18px}\n.kpi{background:rgba(212,160,74,0.08);border:1px solid rgba(212,160,74,0.22);border-radius:14px;padding:20px}\n.kpi .v{font-family:\"SF Mono\",Menlo,Consolas,monospace;font-size:30px;color:#d4a04a;font-weight:700}\n.kpi .l{font-size:12px;color:#9aa7b6;letter-spacing:0.1em;text-transform:uppercase;margin-top:4px}\n.kpi .d{font-size:12px;color:#cdd6e0;margin-top:10px;padding-top:10px;border-top:1px dashed rgba(247,244,238,0.12)}\n\n/* === FAQ grouped === */\n.faq{background:#f7f4ee}\n.faq-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:48px}\n.faq-group h3{font-size:18px;color:#0d1f33;font-weight:700;margin-bottom:18px;padding-bottom:10px;border-bottom:2px solid #d4a04a;display:inline-block}\n.faq-item{background:#fff;border-radius:14px;padding:20px 22px;margin-bottom:14px;box-shadow:0 4px 12px rgba(13,31,51,0.05)}\n.faq-item summary{cursor:pointer;font-size:15px;font-weight:600;color:#0d1f33;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:14px}\n.faq-item summary::-webkit-details-marker{display:none}\n.faq-item summary::after{content:\"+\";color:#d4a04a;font-size:22px;font-weight:300;transition:transform 0.2s;line-height:1}\n.faq-item[open] summary::after{content:\"−\"}\n.faq-item[open] summary{color:#d4a04a}\n.faq-item .answer{font-size:14px;color:#4a5868;margin-top:12px;padding-top:12px;border-top:1px dashed rgba(13,31,51,0.12)}\n\n/* === CLIENTS / PLATFORMS === */\n.clients{background:#fff}\n.client-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:8px}\n.client{background:#f7f4ee;border-radius:14px;padding:24px 20px;text-align:center;box-shadow:0 4px 12px rgba(13,31,51,0.04);transition:transform 0.2s,background 0.2s}\n.client:hover{transform:translateY(-3px);background:#0d1f33;color:#f7f4ee}\n.client .logo{width:44px;height:44px;border-radius:10px;background:#fff;color:#0d1f33;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-weight:700;font-size:14px;box-shadow:0 4px 10px rgba(13,31,51,0.06)}\n.client:hover .logo{background:#d4a04a;color:#0d1f33}\n.client h4{font-size:14px;font-weight:700;color:#0d1f33;margin-bottom:4px}\n.client:hover h4{color:#f7f4ee}\n.client p{font-size:11px;color:#9aa7b6;letter-spacing:0.06em}\n.client:hover p{color:#cdd6e0}\n\n.client-note{margin-top:32px;padding:20px 24px;background:#f7f4ee;border-left:4px solid #d4a04a;border-radius:0 12px 12px 0;font-size:14px;color:#4a5868}\n.client-note strong{color:#0d1f33}\n\n/* === CTA FOOTER === */\n.cta-foot{background:linear-gradient(135deg,#0d1f33,#16314d);color:#f7f4ee;text-align:center;padding:72px 0}\n.cta-foot h2{font-size:30px;font-weight:700;margin-bottom:14px}\n.cta-foot h2 span{color:#d4a04a}\n.cta-foot p{font-size:15px;color:#cdd6e0;max-width:560px;margin:0 auto 28px}\n.cta-foot .cta-row{justify-content:center}\n\nfooter{border-top:1px solid rgba(13,31,51,0.08);padding:28px 0;font-size:12px;color:#9aa7b6;background:#f7f4ee}\nfooter .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;align-items:center}\nfooter .brand-mark .name{font-size:13px;color:#0d1f33}\n\n/* === RESPONSIVE === */\n@media(max-width:960px){.hero-grid{grid-template-columns:1fr;gap:36px;padding:56px 0 72px}\n  .hero-text h1{font-size:36px}\n  .scenario-grid{grid-template-columns:1fr}\n  .workflow-steps{grid-template-columns:1fr 1fr}\n  .plans-stairs{grid-template-columns:1fr;gap:32px}\n  .plan:nth-child(n){transform:none !important}\n  .plan:hover{transform:translateY(-4px) !important}\n  .dash-grid{grid-template-columns:1fr}\n  .faq-grid{grid-template-columns:1fr;gap:32px}\n  .client-grid{grid-template-columns:1fr 1fr}\n  .anchor-tabs{justify-content:flex-start}\n  .topbar{flex-wrap:wrap;gap:18px}}\n@media(max-width:520px){\n  .hero-text h1{font-size:30px}\n  .hero-text .quick-stats{gap:20px}\n  .hero-text .quick-stats .num{font-size:22px}\n  section{padding:64px 0}\n  .section-head h2{font-size:26px}\n  .workflow-steps{grid-template-columns:1fr}\n  .client-grid{grid-template-columns:1fr 1fr}\n  .hero-panel{padding:24px}\n}\n</style>\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"topbar\">\n      <a href=\"#\" class=\"brand-mark\" aria-label=\"跨境电商专用网络首页\">\n        <span class=\"dot\"></span>\n        <span class=\"name\">跨境电商<span>专用网络</span></span>\n      </a>\n      <nav class=\"anchor-tabs\" aria-label=\"页内导航\">\n        <a href=\"#scenarios\">业务场景</a>\n        <a href=\"#workflow\">接入流程</a>\n        <a href=\"#plans\">套餐方案</a>\n        <a href=\"#platforms\">支持平台</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n\n    <div class=\"hero-grid\">\n      <div class=\"hero-text\">\n        <span class=\"eyebrow\">FOR CROSS-BORDER SELLERS</span>\n        <h1>跨境电商专用网络 · 为跨境卖家<br>定制的网络<span>专线服务</span></h1>\n        <p class=\"lede\">面向亚马逊、TikTok Shop、Shopee 等多平台卖家。提供原生归属地 IP、独享带宽与多店铺账号隔离，让运营、采购、客服账号在同一套网络里分得清、跑得稳。</p>\n        <div class=\"quick-stats\">\n          <div><span class=\"num\">60+</span><span class=\"lbl\">国家地区覆盖</span></div>\n          <div><span class=\"num\">99.95%</span><span class=\"lbl\">月度可用率</span></div>\n          <div><span class=\"num\">≤80ms</span><span class=\"lbl\">主流地区延迟</span></div>\n        </div>\n        <div class=\"cta-row\">\n          <a href=\"#plans\" class=\"btn btn-primary\">查看套餐</a>\n          <a href=\"#workflow\" class=\"btn btn-ghost\">了解接入方式</a>\n        </div>\n      </div>\n\n      <aside class=\"hero-panel\" aria-label=\"方案核心参数\">\n        <h2>本月推荐 · 旗舰版</h2>\n        <div class=\"panel-row\"><span class=\"k\">适用规模</span><span class=\"v\">3–10 个店铺<small>亚马逊 / TikTok Shop / 独立站</small></span></div>\n        <div class=\"panel-row\"><span class=\"k\">月度流量</span><span class=\"v\">300 GB<small>可叠加，不清零</small></span></div>\n        <div class=\"panel-row\"><span class=\"k\">并发设备</span><span class=\"v\">5 台设备<small>含 Windows / macOS / 路由器</small></span></div>\n        <div class=\"panel-row\"><span class=\"k\">原生 IP 地区</span><span class=\"v\">美 / 英 / 德 / 日 / 新<small>可按平台切换</small></span></div>\n        <div class=\"panel-row\"><span class=\"k\">专线类型</span><span class=\"v\">IPLC + BGP<small>海外主力路由优化</small></span></div>\n        <div class=\"panel-foot\">\n          <div class=\"price\">¥35<small>/月起 · 年付 ¥350/年</small></div>\n          <a href=\"#plans\" class=\"btn btn-primary\">立即选购</a>\n        </div>\n      </aside>\n    </div>\n  </div>\n</header>\n\n<main>\n\n\n<section id=\"scenarios\" class=\"scenarios\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <span class=\"tag\">SCENARIOS</span>\n      <h2>三类卖家的常见网络痛点</h2>\n      <p>从单店试水、批量扩店，到企业级多团队协作，每一层都对链路有不同的要求。下面是三组最典型的场景。</p>\n    </div>\n    <div class=\"scenario-grid\">\n\n      <article class=\"scenario\">\n        <div class=\"ico\">01</div>\n        <h3>单平台 · 多账号运营</h3>\n        <p>亚马逊、TikTok Shop 同平台多店铺，需要把不同账号环境分到不同 IP，避免因 IP 重叠导致关联审核。</p>\n        <ul>\n          <li>每店独立原生 IP，会话环境干净</li>\n          <li>支持指纹浏览器、ERP、邮件同步工具同开</li>\n          <li>小成本起步，按月灵活切换地区</li>\n        </ul>\n      </article>\n\n      <article class=\"scenario\">\n        <div class=\"ico\">02</div>\n        <h3>多平台 · 选品与采购链路</h3>\n        <p>亚马逊、Shopee、Lazada 同时铺货，团队需要稳定访问各平台后台、海外批发站及竞品页面。</p>\n        <ul>\n          <li>一台设备多国 IP 切换，单条链路不互窜</li>\n          <li>针对选品站、广告投放后台做延迟优化</li>\n          <li>支持长时间挂机，断线自动重拨</li>\n        </ul>\n      </article>\n\n      <article class=\"scenario\">\n        <div class=\"ico\">03</div>\n        <h3>企业级 · 总部与海外分支协同</h3>\n        <p>总部统一管控，海外仓、本地客服、达人合作需要并行连接，要求总部能看见每条链路的运行状态。</p>\n        <ul>\n          <li>专属客户经理，按业务拓扑定制路由</li>\n          <li>工单优先与异常推送，支持二级权限</li>\n          <li>对接现有 SD-WAN、防火墙设备</li>\n        </ul>\n      </article>\n\n    </div>\n  </div>\n</section>\n\n\n<section id=\"workflow\" class=\"workflow\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <span class=\"tag\">HOW IT WORKS</span>\n      <h2>接入流程分四步</h2>\n      <p>从下单到首次联通，实测在支付完成后 10–30 分钟内完成。无需公网 IP、无需更换现有路由器配置。</p>\n    </div>\n    <ol class=\"workflow-steps\">\n      <li class=\"step\"><span class=\"num\">1</span><h3>选择套餐与地区</h3><p>在下单页面选定适合店铺规模的套餐，并选择主用 IP 归属地国家。</p><span class=\"meta\">约 1 分钟</span></li>\n      <li class=\"step\"><span class=\"num\">2</span><h3>获取连接凭证</h3><p>订单确认后，账号后台生成独立的用户名、密钥和节点配置信息。</p><span class=\"meta\">约 3 分钟</span></li>\n      <li class=\"step\"><span class=\"num\">3</span><h3>导入客户端或路由</h3><p>支持 Windows、macOS、Android、iOS 客户端，以及主流软路由固件导入。</p><span class=\"meta\">约 5 分钟</span></li>\n      <li class=\"step\"><span class=\"num\">4</span><h3>开始业务并监控</h3><p>后台可查看每条链路速率、用量、地区切换记录。</p><span class=\"meta\">长期</span></li>\n    </ol>\n  </div>\n</section>\n\n\n<section id=\"plans\" class=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <span class=\"tag\">PRICING</span>\n      <h2>三档套餐 · 按店铺规模选</h2>\n      <p>所有套餐都包含原生 IP、客户端不限次安装、月度流量可结转。下单前 7 天内支持无理由切换到其他套餐，差额按日折算。</p>\n    </div>\n\n    <div class=\"plans-stairs\">\n\n      <article class=\"plan\">\n        <h3>基础版</h3>\n        <div class=\"plan-price\">¥15<small>/月</small></div>\n        <div class=\"annual\">按年付仅需 ¥150/年</div>\n        <ul>\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <a href=\"#\" class=\"plan-cta\">选择基础版</a>\n      </article>\n\n      <article class=\"plan featured\">\n        <span class=\"badge\">MOST PICKED</span>\n        <h3>旗舰版</h3>\n        <div class=\"plan-price\">¥35<small>/月</small></div>\n        <div class=\"annual\">按年付仅需 ¥350/年</div>\n        <ul>\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <a href=\"#\" class=\"plan-cta\">选择旗舰版</a>\n      </article>\n\n      <article class=\"plan\">\n        <h3>团队版</h3>\n        <div class=\"plan-price\">¥85<small>/月</small></div>\n        <div class=\"annual\">按年付仅需 ¥850/年</div>\n        <ul>\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <a href=\"#\" class=\"plan-cta\">联系企业顾问</a>\n      </article>\n\n    </div>\n  </div>\n</section>\n\n\n<section class=\"dashboard\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <span class=\"tag\">CONTROL PANEL</span>\n      <h2>后台一屏看完每条链路</h2>\n      <p>团队管理员账号可以查看各团队成员的链路状态、地区切换记录、剩余流量与异常提示。所有操作日志保留 90 天。</p>\n    </div>\n\n    <div class=\"dash-grid\">\n\n      <div class=\"dash-card\">\n        <h3>近 7 日地区使用占比</h3>\n        <ul class=\"bar-list\">\n          <li>\n            <div class=\"label\"><span>美国 · 弗吉尼亚</span><span>34%</span></div>\n            <div class=\"bar\"><i></i></div>\n          </li>\n          <li>\n            <div class=\"label\"><span>美国 · 俄勒冈</span><span>21%</span></div>\n            <div class=\"bar\"><i></i></div>\n          </li>\n          <li>\n            <div class=\"label\"><span>英国 · 伦敦</span><span>15%</span></div>\n            <div class=\"bar\"><i></i></div>\n          </li>\n          <li>\n            <div class=\"label\"><span>德国 · 法兰克福</span><span>12%</span></div>\n            <div class=\"bar\"><i></i></div>\n          </li>\n          <li>\n            <div class=\"label\"><span>日本 · 东京</span><span>10%</span></div>\n            <div class=\"bar\"><i></i></div>\n          </li>\n          <li>\n            <div class=\"label\"><span>新加坡</span><span>8%</span></div>\n            <div class=\"bar\"><i></i></div>\n          </li>\n        </ul>\n      </div>\n\n      <div class=\"dash-side\">\n        <div class=\"kpi\">\n          <div class=\"v\">236 GB</div>\n          <div class=\"l\">本月已用流量</div>\n          <div class=\"d\">剩余 64 GB · 4 月 25 日重置</div>\n        </div>\n        <div class=\"kpi\">\n          <div class=\"v\">12</div>\n          <div class=\"l\">当前在线账号</div>\n          <div class=\"d\">分布在 5 个国家地区</div>\n        </div>\n        <div class=\"kpi\">\n          <div class=\"v\">0</div>\n          <div class=\"l\">过去 30 天异常</div>\n          <div class=\"d\">无 IP 漂移、无强制下线</div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n\n<section id=\"platforms\" class=\"clients\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <span class=\"tag\">SUPPORTED PLATFORMS</span>\n      <h2>常被卖家访问的目的地</h2>\n      <p>以下平台和工具的访问仅指网络层可达性。是否能注册或登录，仍以平台各自政策为准。</p>\n    </div>\n    <div class=\"client-grid\">\n      <article class=\"client\"><div class=\"logo\">A</div><h4>亚马逊</h4><p>Seller / Vendor Central</p></article>\n      <article class=\"client\"><div class=\"logo\">T</div><h4>TikTok Shop</h4><p>英 / 美 / 东南亚站点</p></article>\n      <article class=\"client\"><div class=\"logo\">S</div><h4>Shopee</h4><p>多国站卖家中心</p></article>\n      <article class=\"client\"><div class=\"logo\">L</div><h4>Lazada</h4><p>六国站业务后台</p></article>\n      <article class=\"client\"><div class=\"logo\">W</div><h4>Windows</h4><p>Win 10 / 11 客户端</p></article>\n      <article class=\"client\"><div class=\"logo\">M</div><h4>macOS</h4><p>原生 Apple Silicon</p></article>\n      <article class=\"client\"><div class=\"logo\">i</div><h4>iOS / iPadOS</h4><p>App Store 客户端</p></article>\n      <article class=\"client\"><div class=\"logo\">A</div><h4>Android</h4><p>手机与平板通用</p></article>\n    </div>\n    <p class=\"client-note\"><strong>说明：</strong>上述软件仅作为可下载安装的目标示例。本页未提供任何具体下载链接，实际下载地址以客户后台生成的专属入口为准，避免被公开传播导致封禁。</p>\n  </div>\n</section>\n\n\n<section id=\"faq\" class=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <span class=\"tag\">FAQ</span>\n      <h2>常见问题 · 分主题整理</h2>\n      <p>下单前最多被问到的问题集中在以下四类。其他场景的疑问可以直接通过下方渠道咨询。</p>\n    </div>\n\n    <div class=\"faq-grid\">\n\n      <div class=\"faq-group\">\n        <h3>关于套餐与计费</h3>\n\n        <details class=\"faq-item\">\n          <summary>流量怎么算？用不完会清零吗？</summary>\n          <div class=\"answer\">所有套餐的月度流量按自然月重置。当月用不完的部分可结转到下月，最多累计两个月；连续两个月仍未使用则清零，下单前请按近期运营节奏选择档位。</div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>可以从基础版升级到旗舰版吗？</summary>\n          <div class=\"answer\">可以。后台随时升级，原套餐剩余时长按金额折算抵扣到新套餐，差额通过原支付渠道退还或追加计费。</div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>可以中途暂停或取消吗？</summary>\n          <div class=\"answer\">支持。月付套餐在下一个续费日之前可随时暂停，期间不扣费；年付套餐支持 30 天内申请按剩余月数退款。</div>\n        </details>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于 IP 与设备</h3>\n\n        <details class=\"faq-item\">\n          <summary>一个套餐允许多少台设备？</summary>\n          <div class=\"answer\">基础版 3 台，旗舰版 5 台，团队版 20 台。这里的“设备”指同一时间登录的客户端数，可以在后台自助解绑并重新绑定新设备。</div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>IP 是固定的吗？能不能指定城市？</summary>\n          <div class=\"answer\">每个账号默认绑定一个长期稳定的 IP。如需切换城市，可在后台节点列表里选择其他可选城市，切换记录可在日志中查看。</div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>家里和公司都需要用，同一个账号行吗？</summary>\n          <div class=\"answer\">可以。旗舰版及以上套餐支持同时 5 路并发，把不同的店铺账号分别绑定在不同的客户端即可，不需要为每家公司单独开账号。</div>\n        </details>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于使用与稳定</h3>\n\n        <details class=\"faq-item\">\n          <summary>支持哪些操作系统？</summary>\n          <div class=\"answer\">Windows 10/11、macOS 11 及以上、Ubuntu 20.04 / 22.04 LTS 提供官方客户端；iOS 和 Android 客户端同步在应用商店发布。</div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>软路由能不能用？怎么配？</summary>\n          <div class=\"answer\">支持 OpenWrt、iKuaiOS、ROS 等主流软路由固件。后台提供通用订阅链接，复制到软路由的订阅处即可批量导入节点。</div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>断线后会自动恢复吗？</summary>\n          <div class=\"answer\">客户端默认开启断线自动重连，触发条件包括本地网络切换、节点维护等。维护前通常会通过站内信和邮件提前通知。</div>\n        </details>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于合规与售后</h3>\n\n        <details class=\"faq-item\">\n          <summary>使用前需要准备什么资料？</summary>\n          <div class=\"answer\">仅需注册时填写真实联系方式用于接收维护通知，无需身份证或营业执照。如需开具增值税专用发票，请在小助手页面提交主体信息。</div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>遇到问题怎么联系？</summary>\n          <div class=\"answer\">工作日 9:00–22:00 提供在线小助手；旗舰版及以上套餐为 7×24 优先工单。账号后台“帮助中心”可一键创建工单并附上问题截图与日志。</div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>节点地区和国家会有变化吗？</summary>\n          <div class=\"answer\">会随上游线路调整而增减。新增地区通常在年度内多次上线，已购买套餐不受影响；下线地区会提前 30 天在账号后台公告并提供替代节点。</div>\n        </details>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n\n<section class=\"cta-foot\">\n  <div class=\"wrap\">\n    <h2>先把<span>网络</span>，跑稳一点</h2>\n    <p>账号注册后可立即领取 1 天旗舰版试用额度，亲身测试节点速度与平台兼容，再决定是否长期合作。</p>\n    <div class=\"cta-row\">\n      <a href=\"#plans\" class=\"btn btn-primary\">查看套餐</a>\n      <a href=\"#workflow\" class=\"btn btn-ghost\">了解接入方式</a>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <a href=\"#\" class=\"brand-mark\" aria-label=\"跨境电商专用网络\">\n      <span class=\"dot\"></span>\n      <span class=\"name\">跨境电商专用网络</span>\n    </a>\n    <span>© 跨境电商专用网络 · 面向跨境卖家的网络服务</span>\n  </div>\n</footer>",
